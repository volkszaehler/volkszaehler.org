{
    "name": "volkszaehler/volkszaehler",
    "type": "project",
    "description": "volkszaehler is a free smart meter implementation with focus on data privacy",
    "homepage": "https://www.volkszaehler.org/",
    "license": "GPL-3.0",
    "support": {
        "wiki": "https://wiki.volkszaehler.org/",
        "email": "volkszaehler@lists.volkszaehler.org"
    },
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^3.5",
        "doctrine/dbal": "^4.2",
        "protonlabs/php-shunting-yard": "^1.0",
        "symfony/cache": "^7.4",
        "symfony/console": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/yaml": "^7.4",
        "cboden/ratchet": "^0.4",
        "ringcentral/psr7": "^1.2",
        "php-pm/php-pm": "^2.0",
        "php-pm/httpkernel-adapter": "^2.0",
        "symfony/uid": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "nyholm/psr7": "^1.1",
        "symfony/psr-http-message-bridge": "^7.4",
        "guzzlehttp/guzzle": "^7.0",
        "jdorn/sql-formatter": "^1.2",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Volkszaehler\\": "lib/",
            "Tests\\": "test/"
        }
    }
}
